NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://postgres:postgres@localhost:5433/ai_research_agent
JWT_SECRET=replace-with-a-long-random-string

LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
GEMINI_API_KEY=
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004

SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
GITHUB_TOKEN=

MAX_TOOL_CALLS=15
MAX_RESEARCH_TIME=120
MAX_SOURCE_BYTES=120000
MCP_RESEARCH_COMMAND=node
MCP_RESEARCH_ARGS=../mcp-servers/dist/research/server.js
MCP_GITHUB_COMMAND=node
MCP_GITHUB_ARGS=../mcp-servers/dist/github/server.js
MCP_MEMORY_COMMAND=node
MCP_MEMORY_ARGS=../mcp-servers/dist/memory/server.js
